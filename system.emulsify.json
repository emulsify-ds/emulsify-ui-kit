{
  "name": "emulsify-ui-kit",
  "homepage": "https://github.com/emulsify-ds/emulsify-ui-kit",
  "repository": "https://github.com/emulsify-ds/emulsify-ui-kit.git",
  "structure": [
    {
      "name": "components",
      "description": "Components commonly used in higher-level components"
    },
    {
      "name": "base",
      "description": "Global styles, generated tokens, and shared Sass utilities."
    },
    {
      "name": "layout",
      "description": "Container, grid, and placeholder layout primitives."
    }
  ],
  "variants": [
    {
      "platform": "drupal",
      "structureImplementations": [
        {
          "name": "components",
          "directory": "./src/components/"
        },
        {
          "name": "base",
          "directory": "./src/base/"
        },
        {
          "name": "layout",
          "directory": "./src/layout/"
        }
      ],
      "directories": [
        {
          "name": "base",
          "path": "./src/base",
          "destinationPath": "./src/base",
          "description": "Shared Sass functions, mixins, and base styles."
        },
        {
          "name": "layout",
          "path": "./src/layout",
          "destinationPath": "./src/layout",
          "description": "Installs the container, grid, and placeholder layout primitives."
        },
        {
          "name": "tokens",
          "path": "./src/tokens",
          "destinationPath": "./src/tokens",
          "description": "Tokens Studio source JSON and the Base token build script."
        },
        {
          "name": "util",
          "path": "./src/util",
          "destinationPath": "./src/util",
          "description": "Shared Storybook helpers."
        },
        {
          "name": "fonts",
          "path": "./assets/fonts",
          "destinationPath": "./assets/fonts",
          "description": "Local fonts referenced by the Base styles."
        }
      ],
      "files": [
        {
          "name": "configma",
          "path": "./config/configma.json",
          "destinationPath": "./config/configma.json",
          "description": "Figma links for Base token and component stories."
        },
        {
          "name": "sd.config",
          "path": "./config/sd.config.json",
          "destinationPath": "./config/sd.config.json",
          "description": "Style Dictionary settings for generating the Base tokens."
        },
        {
          "name": "example-audio-mp3",
          "path": "./assets/audio/ball.mp3",
          "destinationPath": "./assets/audio/ball.mp3",
          "description": "MP3 source for the Audio Player example."
        },
        {
          "name": "example-audio-ogg",
          "path": "./assets/audio/ball.ogg",
          "destinationPath": "./assets/audio/ball.ogg",
          "description": "Ogg source for the Audio Player example."
        },
        {
          "name": "example-camera-image",
          "path": "./assets/images/example/basic-camera-image.png",
          "destinationPath": "./assets/images/example/basic-camera-image.png",
          "description": "Camera image for media examples."
        },
        {
          "name": "example-hero-image",
          "path": "./assets/images/example/hero.jpg",
          "destinationPath": "./assets/images/example/hero.jpg",
          "description": "Image and video poster for Hero examples."
        },
        {
          "name": "example-logo",
          "path": "./assets/images/logo-text.svg",
          "destinationPath": "./assets/images/logo-text.svg",
          "description": "Default artwork for the Logo and Header examples."
        },
        {
          "name": "icon-angle-down",
