{#
 # Group related statistics with an optional introduction.
 #
 # Content props: stats_group__heading, stats_group__heading_level,
 # stats_group__content, stats_group__items (metric and description),
 # stats_group__grid_columns, stats_group__animate.
 # Section props: stats_group__width, stats_group__alignment,
 # stats_group__theme, stats_group__theme__variation, stats_group__bg_color,
 # stats_group__spacing, stats_group__id, stats_group__container__modifiers.
 # Wrapper props: stats_group__blockname, stats_group__modifiers,
 # stats_group__additional_classes, stats_group__attributes.
 # Slot: stats_group__items_content.
 #}
{% set group_attributes = stats_group__attributes|default({}) %}
{% set group_classes = group_attributes.class|default([]) %}
{% set group_classes = group_classes is iterable ? group_classes : [group_classes] %}
{% set group_classes = group_classes|merge(stats_group__additional_classes|default([]))|merge(stats_group__blockname ? ['stats-group'] : []) %}
{% set group_attributes = group_attributes|merge({
  class: bem('stats-group', stats_group__modifiers, stats_group__blockname, group_classes),
  'data-stats-group-animate': stats_group__animate is same as(true) ? 'true' : 'false',
}) %}

{% set statistics %}
  {% block stats_group__items_content %}
    {% if stats_group__items_content is not empty %}
      {{ stats_group__items_content }}
    {% else %}
      {% for item in stats_group__items|default([]) %}
        {% if item.description|default('')|trim and item.metric is defined and item.metric is not null and item.metric ~ '' != '' %}
          <dl {{ bem('item', [], 'stats-group') }}>
            <dt {{ bem('description', [], 'stats-group') }}>{{ item.description|e('html', null, true) }}</dt>
            <dd {{ bem('metric', [], 'stats-group') }}>{{ item.metric|e('html', null, true) }}</dd>
          </dl>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endblock %}
{% endset %}

{% set stats_group_markup %}
  <div {{ add_attributes(group_attributes) }}>
    {% if statistics|trim %}
      {{ include('@layout/grid/grid.twig', {
        grid__columns: stats_group__grid_columns,
        grid__inner__content: statistics,
      }, with_context: false) }}
    {% endif %}
  </div>
{% endset %}

{% embed '@layout/container/container.twig' with {
  container__element: 'section',
  container__heading: stats_group__heading,
  container__heading_level: stats_group__heading_level,
  container__text: stats_group__content,
  container__width: stats_group__width|default('narrow'),
  container__alignment: stats_group__alignment|default('left'),
  container__theme: stats_group__theme,
  container__theme__variation: stats_group__theme__variation,
  container__bg_color: stats_group__bg_color,
  container__spacing: stats_group__spacing|default('two'),
  container__id: stats_group__id,
  container__modifiers: stats_group__container__modifiers,
  stats_group_markup: stats_group_markup,
} only %}
  {% block container__content %}{{ stats_group_markup }}{% endblock %}
{% endembed %}
