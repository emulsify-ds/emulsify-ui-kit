{#
 # Render one social item. Prefer title and url. Legacy text and href also work.
 #}
{% set label = item.title|default(item.text)|default('')|trim %}
{% set destination = item.href|default(item.url) %}
{% set drupal_url = destination.options is defined %}

{% if not drupal_url %}
  {% set destination = destination|default('')|trim %}
  {% set url_prefix = destination|split(':')|first %}
  {% if ':' in destination and '/' not in url_prefix and '?' not in url_prefix and '#' not in url_prefix and url_prefix|lower not in ['http', 'https', 'mailto', 'tel'] %}
    {% set destination = '' %}
  {% endif %}
{% endif %}

{% if label %}
  <li {{ bem('item', [], 'social-nav') }}>
    {% if destination %}
      {% set social_icon %}
        {{ include('@components/icon/icon.twig', {
          icon__name: item.icon|default(label|lower),
          icon__blockname: 'social-nav',
          icon__decorative: true,
        }, with_context: false) }}
      {% endset %}
      {% set social_content %}
        {{ social_icon }}
        <span {{ bem('text', [], 'social-nav', social_icon|trim ? ['visually-hidden'] : []) }}>{{ label|e('html', null, true) }}</span>
      {% endset %}
      {% set link_attrs = bem('link', [], 'social-nav') %}
      {% if drupal_url %}
        {{ link(social_content, destination, link_attrs.toArray())|render }}
      {% else %}
        <a {{ add_attributes({class: link_attrs, href: destination}) }}>{{ social_content }}</a>
      {% endif %}
    {% else %}
      <span {{ bem('text', [], 'social-nav') }}>{{ label|e('html', null, true) }}</span>
    {% endif %}
  </li>
{% endif %}
