{#
 # Disclosure button shared by the compact menu and submenu controls.
 # Pass menu_toggle__label, menu_toggle__controls, optional menu_toggle__icon,
 # menu_toggle__icon_only, menu_toggle__is_root, and menu__base_class.
 #}
{{ include('@components/cta/cta.twig', {
  cta__element: 'button',
  cta__button_type: 'button',
  cta__text: menu_toggle__label,
  cta__icon: menu_toggle__icon|default(null),
  cta__icon_position: menu_toggle__is_root ? 'left' : 'right',
  cta__modifiers: ['clean'],
  cta__additional_classes: [
    menu__base_class|default('menu') ~ '__toggle',
    'base-menu__toggle',
  ],
  cta__attributes: {
    'aria-controls': menu_toggle__controls,
    'aria-expanded': 'true',
    'data-menu-toggle': menu_toggle__is_root ? 'root' : 'submenu',
    'data-menu-icon-only': menu_toggle__icon_only ? 'true' : null,
    hidden: true,
  },
}, with_context: false) }}
