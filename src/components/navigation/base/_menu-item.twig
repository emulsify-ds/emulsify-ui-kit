{# One menu item and the nested list prepared by its parent. #}
{% set item_label = menu_item.title|default(menu_item.text|default('')) %}
{% set item_url = menu_item.url|default(menu_item.href|default('')) %}
{% set item_attributes = menu_item.attributes|default({}) %}
{% if item_attributes.toArray is defined %}
  {% set item_attributes = item_attributes.toArray() %}
{% endif %}
{% set link_attributes = menu_item.link_attributes|default({}) %}
{% set is_current = menu_item.current|default(menu_item.is_active|default(false)) %}
{% set drupal_url = item_url.isRouted is defined %}
{% set has_destination = item_url and (item_url != '#' or not menu_item__submenu_id) %}
{% if drupal_url %}
  {% set has_destination = not (item_url.isRouted() and item_url.getRouteName() in ['<nolink>', '<button>']) %}
{% else %}
  {% set item_url = item_url|trim %}
  {% set scheme = item_url|split(':')|first %}
  {% if ':' in item_url and '/' not in scheme and '?' not in scheme and '#' not in scheme and scheme|lower not in ['https', 'http', 'mailto', 'tel'] %}
    {% set has_destination = false %}
  {% endif %}
{% endif %}
{% set item_classes = item_attributes.class|default([]) %}
{% set item_classes = item_classes is iterable ? item_classes : [item_classes] %}
{% set item_modifiers = menu_item.modifiers|default([])|merge(['level-' ~ menu__level]) %}
{% if menu_item.in_active_trail %}
  {% set item_modifiers = item_modifiers|merge(['active-trail']) %}
{% endif %}
{% set link_classes = link_attributes.class|default([]) %}
{% set link_classes = link_classes is iterable ? link_classes : [link_classes] %}
{% set link_attributes = link_attributes|merge({
  class: bem('link', [], menu__base_class, link_classes|merge(['base-menu__link'])),
}) %}
{% if is_current %}
  {% set link_attributes = link_attributes|merge({'aria-current': 'page'}) %}
{% endif %}
{% if menu_item.aria_label %}
  {% set link_attributes = link_attributes|merge({'aria-label': menu_item.aria_label}) %}
{% endif %}
<li {{ add_attributes(item_attributes|merge({
  class: bem('item', item_modifiers, menu__base_class, item_classes|merge(['base-menu__item'])),
})) }}>
  <div {{ bem('item-label', [], menu__base_class, ['base-menu__item-label']) }}>
    {% if has_destination %}
      {% if drupal_url %}
        {{ link(item_label, item_url, link_attributes) }}
      {% else %}
        <a {{ add_attributes(link_attributes|merge({href: item_url})) }}>{{ item_label|e }}</a>
      {% endif %}
    {% else %}
      <span {{ add_attributes({
        class: bem('placeholder', [], menu__base_class, ['base-menu__label']),
        'data-menu-fallback-label': 'true',
      }) }}>{{ item_label|e }}</span>
    {% endif %}
    {% if menu_item__submenu_id %}
      {{ include('@components/navigation/base/menu-toggle/menu-toggle.twig', {
        menu_toggle__label: has_destination ? menu_item.submenu_label|default(item_label ~ ' ' ~ ('submenu'|t)) : item_label,
        menu_toggle__controls: menu_item__submenu_id,
        menu_toggle__icon: 'chevron-down',
        menu_toggle__icon_only: has_destination,
        menu__base_class: menu__base_class,
      }, with_context: false) }}
    {% endif %}
  </div>
  {{ menu_item__children_content }}
</li>
