{#
 # Shared menu partial. Pass menu__id, menu__name, menu__items, and the
 # optional menu__base_class, menu__blockname, menu__modifiers,
 # menu__additional_classes, menu__attributes, menu__list__type, menu__toggle,
 # menu__level_toggle, menu__toggle_label, or menu__items_content.
 #}
{% import '@components/navigation/base/_menu-list.twig' as menu_list %}
{% set menu_class = menu__base_class|default('menu') %}
{% set nav_attributes = menu__attributes|default({}) %}
{% if nav_attributes.toArray is defined %}
  {% set nav_attributes = nav_attributes.toArray() %}
{% endif %}
{% set nav_id = menu__id|default(nav_attributes.id|default(menu_class)) %}
{% set nav_label = menu__name|default('Navigation'|t) %}
{% set panel_id = nav_id ~ '--panel' %}
{% set nav_items = menu__items|default(items|default([])) %}
{% set extra_classes = nav_attributes.class|default([]) %}
{% set extra_classes = extra_classes is iterable ? extra_classes : [extra_classes] %}
{% set extra_classes = extra_classes|merge(menu__additional_classes|default([]))|merge(['base-menu']) %}
{% set nav_attributes = nav_attributes|merge({
  id: nav_id,
  class: bem(menu_class, menu__modifiers|default([]), menu__blockname|default(''), extra_classes),
  'aria-label': nav_label,
  'data-menu': 'true',
}) %}
{% set options = {
  class: menu_class,
  element: menu__list__type == 'ol' ? 'ol' : 'ul',
  disclosures: menu__level_toggle is same as(true),
} %}

{% set list %}
  {% block menu_list__content %}
    {% if menu__items_content is not empty %}
      <{{ options.element }} {{ bem('menu-list', ['level-0'], menu_class, ['base-menu__list']) }}>{{ menu__items_content }}</{{ options.element }}>
    {% else %}
      {{ menu_list.render(nav_items, options, nav_id, 0) }}
    {% endif %}
  {% endblock %}
{% endset %}

{% if list|trim %}
  <nav {{ add_attributes(nav_attributes) }}>
    {% block menu_prefix %}{% endblock %}
    {% if menu__toggle is same as(true) %}
      {% block menu_toggle__toggle %}
        {{ include('@components/navigation/base/menu-toggle/menu-toggle.twig', {
          menu_toggle__label: menu__toggle_label|default('Menu'|t),
          menu_toggle__controls: panel_id,
          menu_toggle__is_root: true,
          menu_toggle__icon: 'menu',
          menu__base_class: menu_class,
        }, with_context: false) }}
      {% endblock %}
    {% endif %}
    <div {{ add_attributes({
      id: panel_id,
      class: bem('menu-list-wrapper', ['level-0'], menu_class, ['base-menu__panel']),
      'data-menu-root-panel': 'true',
    }) }}>{{ list }}</div>
    {% block menu_suffix %}{% endblock %}
  </nav>
{% endif %}
