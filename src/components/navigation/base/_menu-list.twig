{# Recursive list renderer. Each sibling key contributes to its submenu path. #}
{% macro render(items, options, path, level, panel_id = null) %}
  {% import _self as lists %}
  {% if items %}
    {% set used_keys = [] %}
    <{{ level == 0 ? options.element : 'ul' }} {{ add_attributes({
      id: panel_id,
      class: bem('menu-list', ['level-' ~ level], options.class, ['base-menu__list']),
    }) }}>
      {% for key, item in items %}
        {% set item_key = item.id|default(item.key|default(key)) ~ '' %}
        {% set stable_key = item_key matches '/^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$/' and item_key not in used_keys %}
        {% set used_keys = used_keys|merge([item_key]) %}
        {% set item_path = path ~ '--' ~ (stable_key ? 'key-' ~ item_key : 'index-' ~ loop.index) %}
        {% set children = item.children|default(item.below|default([])) %}
        {% set submenu_id = children and options.disclosures ? item_path ~ '--submenu' : null %}
        {% set submenu %}
          {{ lists.render(children, options, item_path, level + 1, submenu_id) }}
        {% endset %}
        {{ include('@components/navigation/base/_menu-item.twig', {
          menu_item: item,
          menu_item__submenu_id: submenu_id,
          menu_item__children_content: submenu,
          menu__base_class: options.class,
          menu__level: level,
        }, with_context: false) }}
      {% endfor %}
    </{{ level == 0 ? options.element : 'ul' }}>
  {% endif %}
{% endmacro %}
