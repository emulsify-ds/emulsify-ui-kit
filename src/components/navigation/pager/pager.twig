{#
 # A labelled pagination landmark for full and mini Drupal pagers.
 #
 # Props: pager__items, pager__current, pager__ellipses, pager__label,
 # pager__blockname, pager__modifiers, pager__additional_classes, pager__attributes.
 #}
{% set pager_items = pager__items ?? items ?? {} %}
{% set pager_current = (pager__current ?? current ?? pager_items.current ?? '') ~ '' %}
{% set pager_ellipses = pager__ellipses ?? ellipses ?? {} %}
{% set pages = pager_items.pages|default({}) %}
{% set page_numbers = pages|keys %}
{% if page_numbers is empty and pager_current != '' %}
  {% set page_numbers = [pager_current] %}
{% endif %}
{% set controls = {
  first: {glyph: '«', label: 'First page'|t},
  previous: {glyph: '‹', label: 'Previous page'|t, rel: 'prev'},
  next: {glyph: '›', label: 'Next page'|t, rel: 'next'},
  last: {glyph: '»', label: 'Last page'|t},
} %}

{% if page_numbers is not empty or pager_items.first.href or pager_items.previous.href or pager_items.next.href or pager_items.last.href %}
  {% set nav_attributes = pager__attributes|default({}) %}
  {% set classes = nav_attributes.class|default([]) %}
  {% set classes = classes is iterable ? classes : [classes] %}
  {% set classes = classes|merge(pager__additional_classes|default([]))|merge(pager__blockname ? ['pager'] : []) %}
  {% set nav_attributes = nav_attributes|merge({
    class: bem('pager', pager__modifiers, pager__blockname, classes),
    'aria-label': pager__label|default(pagination_id|default('Pagination'|t)),
  }) %}
  <nav {{ add_attributes(nav_attributes) }}>
    <ul {{ bem('items', [], 'pager') }} role="list">
      {% for position in ['first', 'previous', 'pages', 'next', 'last'] %}
        {% if position == 'pages' %}
          {% if pager_ellipses.previous or pager_ellipses.prev %}
            <li {{ bem('item', ['ellipsis'], 'pager') }}>
              <span aria-hidden="true">…</span>
              <span class="visually-hidden">{{ 'More previous pages'|t }}</span>
            </li>
          {% endif %}
          {% for number in page_numbers %}
            {% set page = pages[number]|default({}) %}
            {% set is_current = pager_current != '' and pager_current == number ~ '' %}
            {% set item_attributes = page.attributes|default({}) %}
            {% set item_classes = item_attributes.class|default([]) %}
            {% set item_classes = item_classes is iterable ? item_classes : [item_classes] %}
            {% set item_attributes = item_attributes|merge({
              class: bem('link', is_current ? ['current'] : [], 'pager', item_classes),
              href: not is_current ? page.href|default(null) : null,
              'aria-current': is_current ? 'page' : null,
            }) %}
            {% set tag = not is_current and page.href ? 'a' : 'span' %}
            <li {{ bem('item', [], 'pager') }}>
              <{{ tag }} {{ add_attributes(item_attributes) }}><span class="visually-hidden">{{ 'Page'|t }} </span>{{ number }}</{{ tag }}>
            </li>
          {% endfor %}
          {% if pager_ellipses.next %}
            <li {{ bem('item', ['ellipsis'], 'pager') }}>
              <span aria-hidden="true">…</span>
              <span class="visually-hidden">{{ 'More next pages'|t }}</span>
            </li>
          {% endif %}
        {% elseif pager_items[position].href %}
          {% set item = pager_items[position] %}
          {% set control = controls[position] %}
          {% set item_attributes = item.attributes|default({}) %}
          {% set item_classes = item_attributes.class|default([]) %}
          {% set item_classes = item_classes is iterable ? item_classes : [item_classes] %}
          {% set item_attributes = item_attributes|merge({
            class: bem('link', [position], 'pager', item_classes),
            href: item.href,
            rel: control.rel|default(item_attributes.rel|default(null)),
            'aria-current': null,
          }) %}
          <li {{ bem('item', [position], 'pager') }}>
            <a {{ add_attributes(item_attributes) }}>
              {% if item.text %}
                <span aria-hidden="true">{{ item.text }}</span>
              {% else %}
                <span {{ bem('glyph', [], 'pager') }} aria-hidden="true">{{ control.glyph }}</span>
              {% endif %}
              <span class="visually-hidden">{{ item.text|default(control.label) }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
{% endif %}
