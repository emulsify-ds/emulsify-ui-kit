{#
 # An ordered trail from ancestor pages to the current page.
 #
 # Props: breadcrumbs__items, breadcrumbs__label, breadcrumbs__blockname,
 # breadcrumbs__modifiers, breadcrumbs__additional_classes, breadcrumbs__attributes.
 #}
{% set trail = breadcrumbs__items ?? breadcrumbs_items ?? breadcrumb ?? [] %}
{% if trail %}
  {% set nav_attributes = breadcrumbs__attributes|default({}) %}
  {% set classes = nav_attributes.class|default([]) %}
  {% set classes = classes is iterable ? classes : [classes] %}
  {% set classes = classes|merge(breadcrumbs__additional_classes|default([]))|merge(breadcrumbs__blockname ? ['breadcrumbs'] : []) %}
  {% set nav_attributes = nav_attributes|merge({
    class: bem('breadcrumbs', breadcrumbs__modifiers, breadcrumbs__blockname, classes),
    'aria-label': breadcrumbs__label|default('Breadcrumb'|t),
  }) %}
  <nav {{ add_attributes(nav_attributes) }}>
    <ol {{ bem('list', [], 'breadcrumbs') }} role="list">
      {% for item in trail %}
        {% set text = item.text|default(item.title) %}
        {% set href = item.url|default(item.href) %}
        <li {{ bem('item', [], 'breadcrumbs') }}>
          {% if not loop.first %}
            <span {{ bem('separator', [], 'breadcrumbs') }} aria-hidden="true">/</span>
          {% endif %}
          {% if loop.last %}
            <span aria-current="page">{{ text }}</span>
          {% elseif href %}
            <a {{ add_attributes({class: bem('link', [], 'breadcrumbs'), href: href}) }}>{{ text }}</a>
          {% else %}
            <span>{{ text }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
