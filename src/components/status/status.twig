{#
 # Feedback messages grouped by urgency.
 #
 # Props: status__messages (messages keyed by type), status__labels (label
 # overrides by type), status__dismissible (optional dismiss buttons),
 # status__blockname, status__modifiers, status__additional_classes,
 # status__attributes.
 #}
{% set type_labels = {
  info: 'Information'|t,
  success: 'Success'|t,
  warning: 'Warning'|t,
  error: 'Error'|t,
} %}
{% set type_aliases = { status: 'success', danger: 'error' } %}
{% set groups %}
  {% for type, messages in status__messages|default({}) %}
    {% if messages is iterable and messages is not empty %}
      {% set variant = type_aliases[type]|default(type) %}
      {% set variant = type_labels[variant] is defined ? variant : 'info' %}
      {% set urgent = variant in ['warning', 'error'] %}
      <div {{ add_attributes({
        class: bem('message', [], 'status'),
        'data-status-type': variant,
      }) }}>
        <div {{ add_attributes({
          class: bem('content', [], 'status'),
          role: urgent ? 'alert' : 'status',
        }) }}>
          <p {{ bem('label', [], 'status') }}>
            {{ include('@components/icon/icon.twig', {
              icon__name: urgent ? 'triangle-exclamation' : 'circle-info',
              icon__decorative: true,
              icon__blockname: 'status',
            }, with_context: false) }}
            {{ status__labels[type]|default(type_labels[variant]) }}
          </p>
          {% if messages|length > 1 %}
            <ul {{ bem('list', [], 'status') }}>
              {% for message in messages %}
                <li>{{ message }}</li>
              {% endfor %}
            </ul>
          {% else %}
            <div>{{ messages|first }}</div>
          {% endif %}
        </div>
        {% if status__dismissible is same as(true) %}
          {{ include('@components/cta/cta.twig', {
            cta__element: 'button',
            cta__button_type: 'button',
            cta__text: 'Dismiss'|t,
            cta__modifiers: ['clean'],
            cta__additional_classes: ['status__dismiss'],
            cta__attributes: { 'data-status-dismiss': 'true', hidden: 'hidden' },
          }, with_context: false) }}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
{% endset %}

{% if groups|trim %}
  {% set wrapper_attributes = status__attributes|default({}) %}
  {% set wrapper_classes = wrapper_attributes.class|default([]) %}
  {% set wrapper_classes = wrapper_classes is iterable ? wrapper_classes : [wrapper_classes] %}
  {% set wrapper_classes = wrapper_classes|merge(status__additional_classes|default([]))|merge(status__blockname ? ['status'] : []) %}
  {% set wrapper_attributes = wrapper_attributes|merge({
    class: bem('status', status__modifiers, status__blockname, wrapper_classes),
    role: 'group',
    'aria-label': wrapper_attributes['aria-label']|default('Status messages'|t),
    tabindex: status__dismissible is same as(true) ? '-1' : wrapper_attributes.tabindex|default(null),
  }) %}
  <div {{ add_attributes(wrapper_attributes) }}>{{ groups }}</div>
{% endif %}
