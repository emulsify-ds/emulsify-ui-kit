{#
 # Quotation with an optional attribution caption.
 #
 # Props:
 # - blockquote__quote: Quoted text or rendered formatted content.
 # - blockquote__attribution: Optional primary attribution.
 # - blockquote__attribution_secondary: Optional secondary attribution.
 # - blockquote__style: bar-left, bar-right, or quote-left.
 # - blockquote__blockname: Optional parent BEM block.
 # - blockquote__modifiers: BEM modifiers for the figure.
 # - blockquote__additional_classes: Additional classes for the figure.
 # - blockquote__attributes: Additional attributes for the figure.
 #
 # Slots:
 # - blockquote__quote_content: Replaces the quote prop.
 # - blockquote__attribution_content: Replaces the attribution props.
 #}
{% set blockquote__style = blockquote__style in ['bar-left', 'bar-right', 'quote-left'] ? blockquote__style : 'bar-left' %}
{% set blockquote__classes = blockquote__additional_classes|default([])|merge(blockquote__blockname ? ['blockquote'] : []) %}
{% set blockquote__attributes = blockquote__attributes|default({})|merge({
  class: bem('blockquote', blockquote__modifiers, blockquote__blockname, blockquote__classes),
  'data-blockquote-style': blockquote__style,
}) %}

{% set blockquote__rendered_attribution %}
  {%- block blockquote__attribution_content -%}
    {% if blockquote__attribution_content is defined and blockquote__attribution_content is not empty %}
      {{ blockquote__attribution_content }}
    {% else %}
      {% if blockquote__attribution %}
        <span {{ bem('attribution', [], 'blockquote') }}>{{ blockquote__attribution|e('html', null, true) }}</span>
      {% endif %}
      {% if blockquote__attribution_secondary %}
        <span {{ bem('attribution-secondary', [], 'blockquote') }}>{{ blockquote__attribution_secondary|e('html', null, true) }}</span>
      {% endif %}
    {% endif %}
  {%- endblock -%}
{% endset %}

<figure {{ add_attributes(blockquote__attributes) }}>
  <blockquote {{ bem('quote', [], 'blockquote') }}>
    {%- block blockquote__quote_content -%}
      {{- blockquote__quote_content|default(blockquote__quote) -}}
    {%- endblock -%}
  </blockquote>
  {% if blockquote__rendered_attribution|trim is not empty %}
    <figcaption {{ bem('caption', [], 'blockquote') }}>{{ blockquote__rendered_attribution }}</figcaption>
  {% endif %}
</figure>
