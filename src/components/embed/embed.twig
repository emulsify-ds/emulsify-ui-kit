{#
 # Responsive iframe or trusted widget with an optional introduction and caption.
 #
 # Props: embed__src, embed__title, embed__iframe, embed__heading,
 # embed__heading_level, embed__text, embed__caption, embed__ratio,
 # embed__ratio_custom, embed__width, embed__alignment, embed__theme,
 # embed__theme__variation, embed__bg_color, embed__spacing, embed__id,
 # embed__container__modifiers, embed__blockname, embed__modifiers,
 # embed__additional_classes, embed__attributes, embed__media_modifiers.
 # Slot: embed__content, for trusted composed markup with a title on every iframe.
 #}

{% set src = embed__src|default('')|trim %}
{% set title = embed__title|default('')|trim %}
{% set scheme = src|split(':')|first %}
{% if ':' in src and '/' not in scheme and '?' not in scheme and '#' not in scheme and scheme|lower not in ['http', 'https'] %}
  {% set src = '' %}
{% endif %}

{% set media %}
  {% block embed__content %}
    {% if embed__content is not empty %}
      {{ embed__content }}
    {% elseif embed__iframe %}
      {{ embed__iframe|raw }}
    {% elseif src and title %}
      <iframe {{ add_attributes({
        src: src,
        title: title,
        loading: 'lazy',
        referrerpolicy: 'strict-origin-when-cross-origin',
      }) }} allowfullscreen></iframe>
    {% endif %}
  {% endblock %}
{% endset %}

{# Skip complete attributes so a data-title or quoted attribute value
   cannot be mistaken for the iframe's title. Callers sanitize markup upstream. #}
{# Use one backslash in both Twig runtimes. #}
{% set regex_escape = '\\s'|first %}
{% set other_attribute = 'BSs+(?!title(?=[BSs=BSx2f>]))[^BSs=BSx2f>"\'<]+(?:BSs*=BSs*(?:"[^"]*"|\'[^\']*\'|[^BSs"\'`=<>]+))?' %}
{% set title_value = '"[^"]*[^BSs"][^"]*"|\'[^\']*[^BSs\'][^\']*\'|[^BSs"\'`=<>]+' %}
{% set missing_title = ('/<iframe(?=[BSsBSx2f>])(?!(?:' ~ other_attribute ~ ')*BSs+titleBSs*=BSs*(?:' ~ title_value ~ ')(?=[BSsBSx2f>]))/i')|replace({BS: regex_escape}) %}
{% set has_media = media|trim and not (media matches missing_title) %}

{% if has_media or embed__heading or embed__text %}
  {% set ratio = embed__ratio in ['4-3', '1-1', 'custom'] ? embed__ratio : '16-9' %}
  {% set custom_ratio = embed__ratio_custom|default('')|trim %}
  {% set ratio_number = '[0-9]+(?:BS.[0-9]+)?' %}
  {% set ratio_pattern = ('/^' ~ ratio_number ~ '(?:BSs*BSx2fBSs*' ~ ratio_number ~ ')?$/')|replace({BS: regex_escape}) %}
  {% set ratio_values = custom_ratio|split('/') %}
  {% set media_style = null %}
  {% if ratio == 'custom' and custom_ratio matches ratio_pattern and ratio_values[0]|trim > 0 and ratio_values[1]|default('1')|trim > 0 %}
    {% set media_style = '--embed-aspect-ratio: ' ~ custom_ratio ~ ';' %}
  {% endif %}
  {% set embed_attrs = embed__attributes|default({}) %}
  {% set embed_classes = embed_attrs.class|default([]) %}
  {% set embed_classes = embed_classes is iterable ? embed_classes : [embed_classes] %}
  {% set embed_classes = embed_classes|merge(embed__additional_classes|default([]))|merge(embed__blockname ? ['embed'] : []) %}
  {% set embed_attrs = embed_attrs|merge({
    class: bem('embed', embed__modifiers, embed__blockname, embed_classes),
  }) %}
  {% set embed_markup %}
    {% if has_media %}
      {% set media_tag = embed__caption ? 'figure' : 'div' %}
      <{{ media_tag }} {{ add_attributes(embed_attrs) }}>
        <div {{ add_attributes({
          class: bem('media', embed__media_modifiers, 'embed'),
          'data-embed-ratio': ratio,
          style: media_style,
        }) }}>
          {{ media }}
        </div>
        {% if embed__caption %}
          <figcaption {{ bem('caption', [], 'embed') }}>{{ embed__caption|e('html', null, true) }}</figcaption>
        {% endif %}
      </{{ media_tag }}>
    {% endif %}
  {% endset %}

  {% embed '@layout/container/container.twig' with {
    container__element: 'section',
    container__heading: embed__heading,
    container__heading_level: embed__heading_level,
    container__text: embed__text,
    container__width: embed__width,
    container__alignment: embed__alignment,
    container__theme: embed__theme,
    container__theme__variation: embed__theme__variation,
    container__bg_color: embed__bg_color,
    container__spacing: embed__spacing,
    container__id: embed__id,
    container__modifiers: embed__container__modifiers,
    embed_markup: embed_markup,
  } only %}
    {% block container__content %}{{ embed_markup }}{% endblock %}
  {% endembed %}
{% endif %}
