{#
 # Banner section with introductory copy, actions, and optional media.
 #
 # Content: banner__overline, banner__heading, banner__heading_level,
 # banner__text, banner__ctas, banner__alignment.
 # Media: banner__media_alignment, banner__image__src, banner__image__alt,
 # banner__image__decorative, banner__image__srcset, banner__image__sizes,
 # banner__image__width, banner__image__height, banner__video__sources,
 # banner__video__title, banner__video__tracks, banner__video__poster.
 # Section: banner__id, banner__width, banner__theme, banner__theme__variation,
 # banner__bg_color, banner__spacing, banner__container__modifiers.
 # Wrapper: banner__blockname, banner__modifiers, banner__additional_classes,
 # banner__attributes.
 # Slots: banner__media_content, banner__media_caption_content.
 #}

{% set banner_alignment = banner__alignment in ['center', 'right'] ? banner__alignment : 'left' %}
{% set banner_heading_level = banner__heading_level in [2, 3, 4, 5, 6] ? banner__heading_level : 2 %}
{% set banner_heading_id = banner__id is not empty and banner__heading ? 'banner-heading-' ~ banner__id : null %}
{% set banner_attributes = banner__attributes|default({}) %}
{% set attribute_classes = banner_attributes.class|default([]) %}
{% set attribute_classes = attribute_classes is iterable ? attribute_classes : [attribute_classes] %}
{% set banner_classes = banner__additional_classes|default([])|merge(attribute_classes)|merge(banner__blockname ? ['banner'] : []) %}
{% set banner_attributes = banner_attributes|merge({
  class: bem('banner', banner__modifiers, banner__blockname, banner_classes),
  'data-banner-alignment': banner_alignment,
  'data-banner-media-alignment': banner__media_alignment == 'left' ? 'left' : 'right',
}) %}

{% set banner_media %}
  {% block banner__media_content %}
    {% if banner__media_content is not empty %}
      {{ banner__media_content }}
    {% elseif banner__video__sources is not empty %}
      {{ include('@components/video/video.twig', {
        video__sources: banner__video__sources,
        video__title: banner__video__title|default('Banner video'|t),
        video__tracks: banner__video__tracks|default([]),
        video__poster: banner__video__poster|default(null),
      }, with_context: false) }}
    {% elseif banner__image__src %}
      {{ include('@components/image/image.twig', {
        image__src: banner__image__src,
        image__alt: banner__image__alt|default(''),
        image__decorative: banner__image__decorative is same as(true),
        image__srcset: banner__image__srcset|default(null),
        image__sizes: banner__image__sizes|default(null),
        image__width: banner__image__width|default(null),
        image__height: banner__image__height|default(null),
        image__loading: 'eager',
      }, with_context: false) }}
    {% endif %}
  {% endblock %}
{% endset %}
{% set banner_caption %}
  {% block banner__media_caption_content %}
    {{ banner__media_caption_content }}
  {% endblock %}
{% endset %}

{% set banner_actions %}
  {% set action_count = 0 %}
  {% for action in banner__ctas|default([])|slice(0, 2) %}
    {% if action.content|default('')|trim and action.url|default('')|trim %}
      {{ include('@components/cta/cta.twig', {
        cta__text: action.content,
        cta__url: action.url,
        cta__icon: action.icon|default(null),
        cta__icon_position: action.icon_position|default(null),
        cta__modifiers: [action_count == 0 ? 'primary' : 'secondary'],
      }, with_context: false) }}
      {% set action_count = action_count + 1 %}
    {% endif %}
  {% endfor %}
{% endset %}

{% set banner_panel %}
  <div {{ add_attributes(banner_attributes) }}>
    <div {{ bem('content', [], 'banner') }}>
      {% if banner__overline %}
        <p {{ bem('overline', [], 'banner') }}>{{ banner__overline }}</p>
      {% endif %}
      {% if banner__heading %}
        {{ include('@components/heading/heading.twig', {
          heading__content: banner__heading,
          heading__level: banner_heading_level,
          heading__blockname: 'banner',
          heading__modifiers: ['h2'],
          heading__attributes: banner_heading_id ? { id: banner_heading_id } : {},
        }, with_context: false) }}
      {% endif %}
      {% if banner__text %}
        {{ include('@components/text/_text.twig', {
          text__element: 'div',
          text__content: banner__text,
          text__blockname: 'banner',
        }, with_context: false) }}
      {% endif %}
      {% if banner_actions|trim %}
        <div {{ bem('actions', [], 'banner') }}>{{ banner_actions }}</div>
      {% endif %}
    </div>
    {% if banner_media|trim %}
      {% set media_element = banner_caption|trim ? 'figure' : 'div' %}
      <{{ media_element }} {{ bem('media', [], 'banner') }}>
        {{ banner_media }}
        {% if banner_caption|trim %}
          <figcaption {{ bem('caption', [], 'banner') }}>{{ banner_caption }}</figcaption>
        {% endif %}
      </{{ media_element }}>
    {% endif %}
  </div>
{% endset %}

{% embed '@layout/container/container.twig' with {
  container__element: 'section',
  container__width: banner__width|default('wide'),
  container__theme: banner__theme,
  container__theme__variation: banner__theme__variation,
  container__bg_color: banner__bg_color is defined and banner__bg_color is not same as(null) ? banner__bg_color : true,
  container__spacing: banner__spacing,
  container__id: banner__id,
  container__modifiers: banner__container__modifiers,
  container__attributes: banner_heading_id ? { 'aria-labelledby': banner_heading_id } : {},
  banner_panel: banner_panel,
} only %}
  {% block container__content %}{{ banner_panel }}{% endblock %}
{% endembed %}
