{#
 # HTML video and titled embeds.
 # Props: video__type, video__title, video__sources, video__tracks,
 # video__poster, video__embed_url, video__aspect_ratio, video__autoplay,
 # video__loop, video__decorative, video__caption, video__credit, video__blockname,
 # video__modifiers, video__additional_classes, video__attributes.
 #}

{% set video__type = video__type == 'embed' ? 'embed' : 'html5' %}
{% set video__title = video__title|default('')|trim|default('Video player'|t) %}
{% set video__embed_url = video__embed_url|default('')|trim %}
{% set video__scheme = video__embed_url|split(':')|first %}
{% if ':' in video__embed_url and '/' not in video__scheme and '?' not in video__scheme and '#' not in video__scheme and video__scheme|lower not in ['http', 'https'] %}
  {% set video__embed_url = '' %}
{% endif %}
{% set video__aspect_ratio = video__aspect_ratio in ['4:3', '1:1'] ? video__aspect_ratio : '16:9' %}
{% set video__autoplay = video__autoplay is same as(true) %}
{% set video__loop = video__loop is same as(true) %}
{% set video__show_caption = video__caption|default('')|trim or video__credit|default('')|trim %}
{% set video__tag = video__show_caption ? 'figure' : 'div' %}

{% if (video__type == 'embed' and video__embed_url) or (video__type == 'html5' and video__sources is not empty) %}
  {% set video__attributes = video__attributes|default({}) %}
  {% set video__classes = video__attributes.class|default([]) %}
  {% set video__classes = video__classes is iterable ? video__classes : [video__classes] %}
  {% set video__classes = ['video']|merge(video__classes)|merge(video__additional_classes|default([])) %}
  {% set video__attributes = video__attributes|merge({
    class: bem('video', video__modifiers, video__blockname, video__classes),
    'data-video-player': 'true',
    'data-video-autoplay': video__autoplay and video__type == 'html5' ? 'true' : null,
    'data-video-decorative': video__decorative is same as(true) and video__autoplay and video__type == 'html5' ? 'true' : null,
  }) %}
  <{{ video__tag }} {{ add_attributes(video__attributes) }}>
    <div {{ bem('wrap', [], 'video') }}{% if video__type == 'embed' %} data-video-ratio="{{ video__aspect_ratio }}"{% endif %}>
      {% if video__type == 'embed' %}
        <iframe {{ add_attributes({
          src: video__embed_url,
          title: video__title,
          loading: 'lazy',
        }) }} allowfullscreen></iframe>
      {% else %}
        <video {{ add_attributes({
          class: bem('media', [], 'video'),
          'aria-label': video__title,
          poster: video__poster|default(null),
          preload: 'metadata',
        }) }} controls playsinline{% if video__autoplay %} muted{% endif %}{% if video__loop %} loop{% endif %}>
          {% for source in video__sources %}
            <source {{ add_attributes({
              src: source.src,
              type: source.type|default(null),
            }) }}>
          {% endfor %}
          {% for track in video__tracks|default([]) %}
            <track {{ add_attributes({
              src: track.src,
              kind: track.kind|default('captions'),
              srclang: track.srclang|default(null),
              label: track.label|default(null),
            }) }}{% if track.default is same as(true) %} default{% endif %}>
          {% endfor %}
          {{ 'Your browser does not support HTML video.'|t }}
        </video>
        {% if video__poster or video__autoplay %}
          <div {{ bem('placeholder', [], 'video') }}>
            <button {{ add_attributes({
              class: bem('play', [], 'video'),
              type: 'button',
              'data-video-toggle': 'true',
              'data-video-play-label': 'Play video'|t,
              'data-video-pause-label': 'Pause video'|t,
            }) }} hidden>{{ 'Play video'|t }}</button>
          </div>
        {% endif %}
      {% endif %}
    </div>
    {% if video__show_caption %}
      <figcaption {{ bem('caption', [], 'video') }}>
        {% if video__caption|default('')|trim %}
          <span>{{ video__caption|e('html', null, true) }}</span>
        {% endif %}
        {% if video__credit|default('')|trim %}
          <span {{ bem('credit', [], 'video') }}>{{ video__credit|e('html', null, true) }}</span>
        {% endif %}
      </figcaption>
    {% endif %}
  </{{ video__tag }}>
{% endif %}
