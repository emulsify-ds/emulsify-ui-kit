{#
 # Props:
 # - offcanvas__id: Unique dialog ID. Defaults to a slug of the heading.
 # - offcanvas__heading: Dialog heading and accessible name.
 # - offcanvas__heading_level: Heading level from 2 through 6.
 # - offcanvas__show_heading: Show the heading visually.
 # - offcanvas__type: Nonmodal edge pane or centered modal.
 # - offcanvas__direction: Edge for the pane.
 # - offcanvas__theme, offcanvas__theme__variation: Optional theme and variation.
 # - offcanvas__trigger__text: Trigger button text. Defaults to the heading.
 # - offcanvas__content, offcanvas__suffix: Default body and footer content.
 # - offcanvas__blockname, offcanvas__modifiers,
 #   offcanvas__additional_classes, offcanvas__attributes: Wrapper attributes.
 #
 # Slots:
 # - offcanvas__trigger_content: Inline content of the CTA trigger.
 # - offcanvas__body_content: Replace the default body.
 # - offcanvas__footer_content: Replace the default footer.
 #}
{% set heading = offcanvas__heading|default('')|trim ?: 'Details'|t %}
{% set level = offcanvas__heading_level in [2, 3, 4, 5, 6] ? offcanvas__heading_level : 2 %}
{% set dialog_id = offcanvas__id|default('offcanvas-' ~ heading|lower|replace({' ': '-', '_': '-'})|url_encode) %}
{% set heading_id = dialog_id ~ '-heading' %}
{% set type = offcanvas__type == 'modal' ? 'modal' : 'pane' %}
{% set direction = offcanvas__direction in ['top', 'right', 'bottom', 'left'] ? offcanvas__direction : 'right' %}

{% set theme = offcanvas__theme|default('') %}
{% set variation = offcanvas__theme__variation|default(theme in ['light', 'dark'] ? theme : 'light') %}
{% set wrapper_attributes = offcanvas__attributes|default({}) %}
{% set wrapper_classes = wrapper_attributes.class|default([]) %}
{% set wrapper_classes = wrapper_classes is iterable ? wrapper_classes : [wrapper_classes] %}
{% set wrapper_classes = wrapper_classes|merge(offcanvas__additional_classes|default([])) %}
{% set wrapper_attributes = wrapper_attributes|merge({
  class: bem('offcanvas', offcanvas__modifiers, offcanvas__blockname, wrapper_classes|merge(offcanvas__blockname ? ['offcanvas'] : [])),
  'data-offcanvas': 'true',
}) %}
{% if theme or offcanvas__theme__variation %}
  {% set wrapper_attributes = wrapper_attributes|merge({
    'data-component-theme': 'default ' ~ (variation == 'dark' ? 'dark' : 'light'),
  }) %}
{% endif %}

{% set trigger_content %}
  {% block offcanvas__trigger_content %}{{ offcanvas__trigger_content }}{% endblock %}
{% endset %}

{% set trigger_props = {
  cta__text: offcanvas__trigger__text|default(heading),
  cta__element: 'button',
  cta__button_type: 'button',
  cta__modifiers: ['primary'],
  cta__additional_classes: ['offcanvas__trigger'],
  cta__attributes: {
    hidden: true,
    'data-offcanvas-trigger': 'true',
    'aria-haspopup': 'dialog',
    'aria-expanded': 'false',
    'aria-controls': dialog_id,
  },
} %}

<div {{ add_attributes(wrapper_attributes) }}>
  {% if trigger_content|trim %}
    {% embed '@components/cta/cta.twig' with trigger_props|merge({ trigger_content: trigger_content, offcanvas__heading: offcanvas__heading }) only %}
      {% block cta__content %}{{ trigger_content }}{% endblock %}
    {% endembed %}
  {% else %}
    {{ include('@components/cta/cta.twig', trigger_props, with_context: false) }}
  {% endif %}

  <dialog open {{ add_attributes({
    id: dialog_id,
    class: bem('dialog', [], 'offcanvas'),
    'aria-labelledby': heading_id,
    'data-offcanvas-type': type,
    'data-offcanvas-direction': type == 'pane' ? direction : null,
  }) }}>
    <div {{ bem('header', [], 'offcanvas') }}>
      <h{{ level }} {{ add_attributes({
        id: heading_id,
        class: bem('heading', [], 'offcanvas', offcanvas__show_heading is same as(false) ? ['visually-hidden'] : []),
      }) }}>{{ heading|e('html', null, true) }}</h{{ level }}>
      {{ include('@components/cta/cta.twig', {
        cta__text: 'Close'|t,
        cta__element: 'button',
        cta__button_type: 'button',
        cta__modifiers: ['clean'],
        cta__icon: 'xmark',
        cta__additional_classes: ['offcanvas__close'],
        cta__attributes: { hidden: true, 'data-offcanvas-close': 'true' },
      }, with_context: false) }}
    </div>

    <div {{ bem('content', [], 'offcanvas') }}>
      {% block offcanvas__body_content %}{{ offcanvas__body_content ?? offcanvas__content }}{% endblock %}
    </div>

    {% set footer_content %}
      {% block offcanvas__footer_content %}{{ offcanvas__footer_content ?? offcanvas__suffix }}{% endblock %}
    {% endset %}
    {% if footer_content|trim %}
      <footer {{ bem('suffix', [], 'offcanvas') }}>{{ footer_content }}</footer>
    {% endif %}
  </dialog>
</div>
