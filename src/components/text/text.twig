{#
 # Whole formatted text value in a section container.
 #
 # Props:
 # - text__content: Processed formatted text or rendered text field.
 # - text__heading, text__heading_level: Optional container introduction heading.
 # - text__width, text__alignment, text__theme, text__theme__variation:
 #   Container width, alignment, and theme.
 # - text__bg_color, text__spacing, text__id, text__container__modifiers:
 #   Container background, spacing, ID suffix, and optional modifiers.
 # - text__blockname, text__modifiers, text__additional_classes, text__attributes:
 #   BEM and attributes for the formatted text wrapper.
 #
 # Slots:
 # - text__formatted_content: Replaces the default formatted text.
 #}
{% set text__classes = text__additional_classes|default([])|merge(text__blockname ? ['text'] : []) %}
{% set text__attributes = text__attributes|default({})|merge({
  class: bem('text', text__modifiers, text__blockname, text__classes),
}) %}

{% set text__rendered %}
  <div {{ add_attributes(text__attributes) }}>
    {%- block text__formatted_content -%}
      {{- text__formatted_content|default(text__content) -}}
    {%- endblock -%}
  </div>
{% endset %}

{% embed '@layout/container/container.twig' with {
  container__width: text__width|default('narrow'),
  container__alignment: text__alignment,
  container__theme: text__theme,
  container__theme__variation: text__theme__variation,
  container__bg_color: text__bg_color,
  container__spacing: text__spacing,
  container__id: text__id,
  container__modifiers: text__container__modifiers,
  container__heading: text__heading,
  container__heading_level: text__heading_level,
  text__rendered: text__rendered,
} only %}
  {% block container__content %}{{ text__rendered }}{% endblock %}
{% endembed %}
