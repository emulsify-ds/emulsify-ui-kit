{#
 # Props:
 # - tags__items: Tags with title, optional url, and optional color.
 # - tags__blockname: Optional parent BEM block name.
 # - tags__modifiers: BEM modifiers for the list.
 # - tags__additional_classes: Extra classes for the list.
 # - tags__attributes: Extra attributes for the list.
 #
 # Slots:
 # - tags__items_content: Replace the generated list-item markup.
 #}
{% set tags_rendered_items %}
  {% block tags__items_content %}
    {% if tags__items_content is defined and tags__items_content is not null %}
      {{ tags__items_content }}
    {% else %}
      {% for item in tags__items|default([]) %}
        {% set tag_label = item.title|default('')|trim %}
        {% if tag_label %}
          {% set tag_url = item.url|default('')|trim %}
          {% set url_prefix = tag_url|split(':')|first %}
          {% if ':' in tag_url and '/' not in url_prefix and '?' not in url_prefix and '#' not in url_prefix and url_prefix|lower not in ['http', 'https', 'mailto', 'tel'] %}
            {% set tag_url = '' %}
          {% endif %}
          {% set tag_color = item.color|default('')|trim %}
          {% set tag_label_attributes = {class: bem('link', [], 'tags')} %}
          {% if tag_color in ['primary', 'dark', 'yellow', 'green'] %}
            {% set tag_label_attributes = tag_label_attributes|merge({'data-tag-color': tag_color}) %}
          {% elseif tag_color %}
            {% set tag_label_attributes = tag_label_attributes|merge({'data-tag-custom-color': tag_color}) %}
          {% endif %}
          {% if tag_url %}
            {% set tag_label_attributes = tag_label_attributes|merge({href: tag_url}) %}
          {% endif %}
          {% set tag_element = tag_url ? 'a' : 'span' %}
          <li {{ bem('item', [], 'tags') }}>
            <{{ tag_element }} {{ add_attributes(tag_label_attributes) }}>{{ tag_label|e('html', null, true) }}</{{ tag_element }}>
          </li>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endblock %}
{% endset %}

{% if tags_rendered_items|trim %}
  {% set tags_wrapper_attributes = tags__attributes|default({}) %}
  {% set tag_attribute_classes = tags_wrapper_attributes.class|default([]) %}
  {% set tag_attribute_classes = tag_attribute_classes is iterable ? tag_attribute_classes : [tag_attribute_classes] %}
  {% set tag_classes = tags__additional_classes|default([])|merge(tag_attribute_classes)|merge(tags__blockname ? ['tags'] : []) %}
  {# Keep list semantics in Safari when markers are hidden. #}
  <ul {{ add_attributes(tags_wrapper_attributes|merge({
    class: bem('tags', tags__modifiers, tags__blockname, tag_classes),
    role: 'list',
  })) }}>{{ tags_rendered_items }}</ul>
{% endif %}
