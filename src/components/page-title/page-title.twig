{#
 # Page introduction with the page's h1 and optional supporting material.
 #
 # Props:
 # - page_title__heading: Required page heading.
 # - page_title__overline, page_title__overline__url: Short label and optional link.
 # - page_title__subheading: Supporting text.
 # - page_title__ctas: Up to two actions with content, url, icon, and icon_position.
 # - page_title__layout: Inline or stacked media layout.
 # - page_title__media_alignment: Left or right media placement in the inline layout.
 # - page_title__width, page_title__alignment, page_title__theme,
 #   page_title__theme__variation, page_title__bg_color, page_title__spacing,
 #   page_title__id, page_title__container__modifiers: Shared Container controls.
 # - page_title__blockname, page_title__modifiers, page_title__additional_classes,
 #   page_title__attributes: Wrapper classes and attributes.
 #
 # Slots:
 # - page_title__breadcrumbs_content: Optional navigation trail.
 # - page_title__description_content: Formatted content below the subheading.
 # - page_title__media_content: Composed image or video.
 #}

{% set title_attributes = page_title__attributes|default({}) %}
{% set title_classes = title_attributes.class|default([]) %}
{% set title_classes = title_classes is iterable ? title_classes : [title_classes] %}
{% set title_classes = title_classes|merge(page_title__additional_classes|default([]))|merge(page_title__blockname ? ['page-title'] : []) %}
{% set title_attributes = title_attributes|merge({
  class: bem('page-title', page_title__modifiers, page_title__blockname, title_classes),
  'data-page-title-layout': page_title__layout == 'stacked' ? 'stacked' : 'inline',
  'data-media-alignment': page_title__media_alignment == 'left' ? 'left' : 'right',
}) %}

{% set breadcrumbs %}
  {% block page_title__breadcrumbs_content %}{{ page_title__breadcrumbs_content }}{% endblock %}
{% endset %}
{% set description %}
  {% block page_title__description_content %}{{ page_title__description_content }}{% endblock %}
{% endset %}
{% set media %}
  {% block page_title__media_content %}{{ page_title__media_content }}{% endblock %}
{% endset %}
{% set actions %}
  {% set action_count = 0 %}
  {% for action in page_title__ctas|default([])|slice(0, 2) %}
    {% if action.content|default('')|trim and action.url|default('')|trim %}
      {{ include('@components/cta/cta.twig', {
        cta__text: action.content,
        cta__url: action.url,
        cta__icon: action.icon,
        cta__icon_position: action.icon_position,
        cta__modifiers: [action_count == 0 ? 'primary' : 'secondary'],
      }, with_context: false) }}
      {% set action_count = action_count + 1 %}
    {% endif %}
  {% endfor %}
{% endset %}

{% set content %}
  <div {{ add_attributes(title_attributes) }}>
    {% if breadcrumbs|trim %}
      <div {{ bem('breadcrumbs', [], 'page-title') }}>{{ breadcrumbs }}</div>
    {% endif %}
    <div {{ bem('body', [], 'page-title') }}>
      <div {{ bem('copy', [], 'page-title') }}>
        {% if page_title__overline %}
          <p {{ bem('overline', [], 'page-title') }}>
            {% if page_title__overline__url %}
              {{ include('@components/cta/cta.twig', {
                cta__text: page_title__overline,
                cta__url: page_title__overline__url,
                cta__modifiers: ['link'],
              }, with_context: false) }}
            {% else %}
              {{ page_title__overline|e }}
            {% endif %}
          </p>
        {% endif %}
        {{ include('@components/heading/heading.twig', {
          heading__content: page_title__heading|e,
          heading__level: 1,
          heading__blockname: 'page-title',
        }, with_context: false) }}
        {% if page_title__subheading %}
          <p {{ bem('subheading', [], 'page-title') }}>{{ page_title__subheading|e }}</p>
        {% endif %}
        {% if description|trim %}
          <div {{ bem('description', [], 'page-title') }}>{{ description }}</div>
        {% endif %}
        {% if actions|trim %}
          <div {{ bem('actions', [], 'page-title') }}>{{ actions }}</div>
        {% endif %}
      </div>
      {% if media|trim %}
        <div {{ bem('media', [], 'page-title') }}>{{ media }}</div>
      {% endif %}
    </div>
  </div>
{% endset %}

{% embed '@layout/container/container.twig' with {
  container__width: page_title__width|default('wide'),
  container__alignment: page_title__alignment,
  container__theme: page_title__theme,
  container__theme__variation: page_title__theme__variation,
  container__bg_color: page_title__bg_color,
  container__spacing: page_title__spacing|default('two'),
  container__id: page_title__id,
  container__modifiers: page_title__container__modifiers,
  page_title__heading: page_title__heading,
  content: content,
} only %}
  {% block container__content %}{{ content }}{% endblock %}
{% endembed %}
