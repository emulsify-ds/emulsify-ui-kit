{#
 # A brief notice with an optional icon, navigation actions, and dismissal.
 #
 # Props:
 # - announcement__heading, announcement__heading_level: Title and level.
 # - announcement__content: Plain text of the notice.
 # - announcement__icon: Optional decorative icon name.
 # - announcement__variant: Default or tinted surface.
 # - announcement__ctas: Up to two links with content, url, icon, and icon_position.
 # - announcement__dismissible: Offer dismissal when behaviors attach.
 # - announcement__blockname, announcement__modifiers,
 #   announcement__additional_classes, announcement__attributes: Wrapper overrides.
 #}

{% set announcement_attributes = announcement__attributes|default({}) %}
{% set announcement_classes = announcement_attributes.class|default([]) %}
{% set announcement_classes = announcement_classes is iterable ? announcement_classes : [announcement_classes] %}
{% set announcement_classes = announcement_classes|merge(announcement__additional_classes|default([]))|merge(announcement__blockname ? ['announcement'] : []) %}
{% set announcement_attributes = announcement_attributes|merge({
  class: bem('announcement', announcement__modifiers, announcement__blockname, announcement_classes),
  'data-announcement-variant': announcement__variant == 'tint' ? 'tint' : 'default',
}) %}
{% set heading_level = announcement__heading_level in [2, 3, 4, 5, 6, '2', '3', '4', '5', '6'] ? announcement__heading_level : 4 %}

{% set announcement_actions %}
  {% set action_count = 0 %}
  {% for action in announcement__ctas|default([])|slice(0, 2) %}
    {% if action.content|default('')|trim and action.url|default('')|trim %}
      {{ include('@components/cta/cta.twig', {
        cta__text: action.content,
        cta__url: action.url,
        cta__icon: action.icon|default(null),
        cta__icon_position: action.icon_position|default('right'),
        cta__modifiers: [action_count == 0 ? 'primary' : 'secondary'],
      }, with_context: false) }}
      {% set action_count = action_count + 1 %}
    {% endif %}
  {% endfor %}

  {% if announcement__dismissible is same as(true) %}
    {{ include('@components/cta/cta.twig', {
      cta__element: 'button',
      cta__text: 'Dismiss announcement'|t,
      cta__modifiers: ['clean'],
      cta__attributes: { 'data-announcement-dismiss': 'true', hidden: 'hidden' },
    }, with_context: false) }}
  {% endif %}
{% endset %}

<div {{ add_attributes(announcement_attributes) }}>
  <div {{ bem('body', [], 'announcement') }}>
    {% if announcement__icon %}
      {{ include('@components/icon/icon.twig', {
        icon__name: announcement__icon,
        icon__blockname: 'announcement',
        icon__decorative: true,
      }, with_context: false) }}
    {% endif %}
    <div {{ bem('text', [], 'announcement') }}>
      {{ include('@components/heading/heading.twig', {
        heading__level: heading_level,
        heading__content: announcement__heading|e('html', null, true),
        heading__blockname: 'announcement',
        heading__modifiers: ['h4'],
      }, with_context: false) }}
      <p {{ bem('content', [], 'announcement') }}>{{ announcement__content|e('html', null, true) }}</p>
    </div>
  </div>
  {% if announcement_actions|trim %}
    <div {{ bem('actions', [], 'announcement') }}>{{ announcement_actions }}</div>
  {% endif %}
</div>
