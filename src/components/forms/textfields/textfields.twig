{% set fields = [
  { id: 'forms-name', name: 'name', type: 'text', title: 'Name'|t, required: true, autocomplete: 'name' },
  {
    id: 'forms-email',
    name: 'email',
    type: 'email',
    title: 'Email address'|t,
    autocomplete: 'email',
    required: true,
    value: 'reader@',
    description: 'We will send a confirmation to this address.'|t,
    error: 'Enter a complete email address, such as reader@example.com.'|t,
  },
  { id: 'forms-website', name: 'website', type: 'url', title: 'Website'|t, autocomplete: 'url' },
  { id: 'forms-places', name: 'places', type: 'number', title: 'Places needed'|t },
] %}

<fieldset class="form-fieldset">
  <legend>{{ 'Workshop registration'|t }}</legend>
  {% for field in fields %}
    {% set references = [] %}
    {% set input_attrs = { id: field.id, name: field.name, type: field.type } %}
    {% if field.autocomplete %}
      {% set input_attrs = input_attrs|merge({ autocomplete: field.autocomplete }) %}
    {% endif %}
    {% if field.required %}
      {% set input_attrs = input_attrs|merge({ required: true }) %}
    {% endif %}
    {% if field.value %}
      {% set input_attrs = input_attrs|merge({ value: field.value }) %}
    {% endif %}
    {% if field.description %}
      {% set references = references|merge([field.id ~ '--description']) %}
    {% endif %}
    {% if field.error %}
      {% set input_attrs = input_attrs|merge({ 'aria-invalid': 'true' }) %}
      {% set references = references|merge([field.id ~ '--error']) %}
    {% endif %}
    {% if references %}
      {% set input_attrs = input_attrs|merge({ 'aria-describedby': references|join(' ') }) %}
    {% endif %}

    {{ include('@components/forms/_form-element.twig', {
      attributes: add_attributes(),
      label: include('@components/forms/_form-label.twig', {
        attributes: add_attributes({ for: field.id }),
        title: field.title,
        required: field.required,
      }, with_context: false),
      label_display: 'before',
      description: {
        content: field.description,
        attributes: add_attributes({ id: field.id ~ '--description' }),
      },
      description_display: 'after',
      errors: field.error,
      error_attributes: add_attributes({ id: field.id ~ '--error' }),
      children: include('@components/forms/_input.twig', {
        attributes: add_attributes(input_attrs),
      }, with_context: false),
    }, with_context: false) }}
  {% endfor %}

  <div class="form-item">
    <label for="forms-notes" class="form-item__label">{{ 'Access needs'|t }}</label>
    <textarea id="forms-notes" name="notes" rows="3" class="form-item__textfield"></textarea>
  </div>
</fieldset>

{{ include('@components/cta/cta.twig', {
  cta__element: 'button',
  cta__button_type: 'submit',
  cta__text: 'Register'|t,
  cta__modifiers: ['primary'],
}, with_context: false) }}
