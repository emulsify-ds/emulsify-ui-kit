{% if not attributes %}
  <fieldset class="form-fieldset form-item--radio">
    <legend>{{ 'Preferred session'|t }}</legend>
    <ul class="form-item--radios" role="list">
{% endif %}

{% for key, radio in radios %}
  {{ include('@components/forms/radio/_radio-item.twig', {
    key: key,
    radio_item: radio.title,
    radio_item_checked: radio.checked,
    radio_item_disabled: radio.disabled,
  }, with_context: false) }}
{% endfor %}

{% if not attributes %}
    </ul>
  </fieldset>
{% endif %}
