{#
 # Props: accordion__controls_label, accordion__expand_all_label,
 # accordion__collapse_all_label.
 #}

<div {{ add_attributes({
  class: bem('controls', [], 'accordion'),
  role: 'group',
  'aria-label': accordion__controls_label|default('Accordion controls'|t),
  'data-accordion-controls': 'true',
}) }} hidden>
  {{ include('@components/cta/cta.twig', {
    cta__element: 'button',
    cta__button_type: 'button',
    cta__text: accordion__expand_all_label|default('Expand all'|t),
    cta__modifiers: ['clean'],
    cta__attributes: { 'data-accordion-bulk': 'expand' },
  }, with_context: false) }}
  {{ include('@components/cta/cta.twig', {
    cta__element: 'button',
    cta__button_type: 'button',
    cta__text: accordion__collapse_all_label|default('Collapse all'|t),
    cta__modifiers: ['clean'],
    cta__attributes: { 'data-accordion-bulk': 'collapse' },
  }, with_context: false) }}
</div>
