{#
 # Available Props:
 # - media_box__width: narrow, content, wide or full
 # - media_box__spacing: spacing preset for the surrounding container
 # - media_box__position: image-left (default) or image-right
 # - media_box__focus: equal (default), image, or text
 #
 # Available variables:
 # - media_box__heading
 # - media_box__subheading (optional)
 # - media_box__text
 #
 # Available blocks:
 # - media_box__media
 #}

{% set media_box__base_class = 'media-box' %}
{% set media_box__attributes = {
  'class': bem(media_box__base_class, media_box__modifiers, media_box__blockname)
} %}
{% set media_box__container__modifiers = media_box__container__modifiers|default([]) %}

{% set media_box %}
  <div {{ add_attributes(media_box__attributes) }}>
    {% block media_box__media %}
      {% if media_box__type == 'image' %}
        {{ include('@components/image/image.twig', {
          image__src: media_box__image__src|default('https://placehold.co/320x213'),
          image__alt: media_box__image__alt|default(''),
          image__decorative: media_box__image__decorative or media_box__image__src is empty,
          image__srcset: media_box__image__srcset,
          image__sizes: media_box__image__sizes|default('100vw'),
          image__caption: media_box__show_caption ? media_box__caption : null,
          image__credit: media_box__show_copyright ? media_box__copyright : null,
        }, with_context: false) }}
      {% else %}
        {{ include('@components/video/video.twig', {
          video__type: 'html5',
          video__title: media_box__heading|default('Media Box video'|t),
          video__sources: [{ src: 'https://www.learningcontainer.com/wp-content/uploads/2020/05/sample-mp4-file.mp4', type: 'video/mp4' }],
          video__caption: media_box__show_caption ? media_box__caption : null,
          video__credit: media_box__show_copyright ? media_box__copyright : null,
        }, with_context: false) }}
      {% endif %}
    {% endblock %}
  </div>
{% endset %}

{# Render the accordion within a generic container #}
{% embed "@layout/container/container.twig" with {
  container__width: media_box__width,
  container__alignment: 'center',
  container__spacing: media_box__spacing,
  container__modifiers: media_box__container__modifiers,
  container__heading: media_box__heading,
  container__text: media_box__text,
}%}
	{% block container__content %}
		{{ media_box }}
	{% endblock %}
{% endembed %}
