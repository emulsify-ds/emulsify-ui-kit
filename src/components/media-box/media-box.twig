{#
 # Media Box places composed media below a section introduction.
 #
 # Props: media_box__type, media_box__media, media_box__id, media_box__width,
 # media_box__theme, media_box__theme__variation, media_box__bg_color,
 # media_box__spacing, media_box__heading, media_box__heading_level,
 # media_box__subheading, media_box__text, media_box__container__modifiers,
 # media_box__image__src, media_box__image__alt, media_box__image__decorative,
 # media_box__image__srcset, media_box__image__sizes, media_box__image__sources,
 # media_box__image__width, media_box__image__height, media_box__image__loading,
 # media_box__image__url, media_box__image__caption, media_box__image__credit,
 # media_box__video__type, media_box__video__title, media_box__video__sources,
 # media_box__video__tracks, media_box__video__poster, media_box__video__embed_url,
 # media_box__video__aspect_ratio, media_box__video__autoplay, media_box__video__loop,
 # media_box__video__caption, media_box__video__credit, media_box__caption,
 # media_box__copyright, media_box__show_caption, media_box__show_copyright,
 # media_box__blockname, media_box__modifiers, media_box__additional_classes,
 # media_box__attributes.
 #
 # Slot: media_box__media_content.
 #}

{% set media_box__type = media_box__type == 'video' ? 'video' : 'image' %}
{% set media_box__show_caption = media_box__show_caption is not same as(false) %}
{% set media_box__show_copyright = media_box__show_copyright is not same as(false) %}

{% set media_box__content %}
  {% block media_box__media_content %}
    {% if media_box__media_content is defined and media_box__media_content is not null %}
      {{ media_box__media_content }}
    {% elseif media_box__type == 'video' %}
      {{ include('@components/video/video.twig', {
        video__type: media_box__video__type|default('html5'),
        video__title: media_box__video__title|default('Video player'|t),
        video__sources: media_box__video__sources|default([]),
        video__tracks: media_box__video__tracks|default([]),
        video__poster: media_box__video__poster|default(null),
        video__embed_url: media_box__video__embed_url|default(null),
        video__aspect_ratio: media_box__video__aspect_ratio|default('16:9'),
        video__autoplay: media_box__video__autoplay is same as(true),
        video__loop: media_box__video__loop is same as(true),
        video__caption: media_box__show_caption ? media_box__video__caption|default(media_box__caption) : null,
        video__credit: media_box__show_copyright ? media_box__video__credit|default(media_box__copyright) : null,
      }, with_context: false) }}
    {% else %}
      {% set media_box__image__src = media_box__image__src|default(media_box__media)|default('') %}
      {% if media_box__image__src %}
        {{ include('@components/image/image.twig', {
          image__src: media_box__image__src,
          image__alt: media_box__image__alt|default(''),
          image__decorative: media_box__image__decorative is same as(true),
          image__srcset: media_box__image__srcset|default(null),
          image__sizes: media_box__image__sizes|default(null),
          image__sources: media_box__image__sources|default([]),
          image__width: media_box__image__width|default(null),
          image__height: media_box__image__height|default(null),
          image__loading: media_box__image__loading|default('lazy'),
          image__url: media_box__image__url|default(null),
          image__caption: media_box__show_caption ? media_box__image__caption|default(media_box__caption) : null,
          image__credit: media_box__show_copyright ? media_box__image__credit|default(media_box__copyright) : null,
        }, with_context: false) }}
      {% endif %}
    {% endif %}
  {% endblock %}
{% endset %}

{% set media_box__attributes = media_box__attributes|default({}) %}
{% set media_box__classes = media_box__attributes.class|default([]) %}
{% set media_box__classes = media_box__classes is iterable ? media_box__classes : [media_box__classes] %}
{% set media_box__classes = media_box__classes|merge(media_box__additional_classes|default([])) %}
{% set media_box__attributes = media_box__attributes|merge({
  class: bem('media-box', media_box__modifiers, media_box__blockname, media_box__classes),
  'data-media-type': media_box__type,
}) %}

{% embed '@layout/container/container.twig' with {
  container__id: media_box__id|default(null),
  container__width: media_box__width|default('content'),
  container__theme: media_box__theme|default(null),
  container__theme__variation: media_box__theme__variation|default(null),
  container__bg_color: media_box__bg_color|default(false),
  container__spacing: media_box__spacing|default('one'),
  container__modifiers: media_box__container__modifiers|default([]),
  container__heading: media_box__heading|default(null),
  container__heading_level: media_box__heading_level|default(2),
  container__subheading: media_box__subheading|default(null),
  container__text: media_box__text|default(null),
  media_box__content: media_box__content,
  media_box__attributes: media_box__attributes,
} only %}
  {% block container__content %}
    {% if media_box__content|trim %}
      <div {{ add_attributes(media_box__attributes) }}>
        {{ media_box__content }}
      </div>
    {% endif %}
  {% endblock %}
{% endembed %}
