{#
  Placeholder
  - placeholder__text: Visible text for the sample area.
  - placeholder__modifiers: BEM modifiers for the root.
  - placeholder__additional_classes: Additional classes for the root.
  - placeholder__attributes: Attributes for the root.
#}
{% set placeholder__attributes = placeholder__attributes|default({})|merge({
  class: bem('placeholder', placeholder__modifiers|default([]), '', placeholder__additional_classes|default([])),
}) %}

<div {{ add_attributes(placeholder__attributes) }}>
  <span {{ bem('content', [], 'placeholder') }}>
    {{ placeholder__text|default('Placeholder'|t)|escape }}
  </span>
</div>
