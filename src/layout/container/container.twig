{#
 # Section layout wrapper.
 #
 # Props:
 # - container__element: Wrapper element. Defaults to div.
 # - container__id: Anchor suffix rendered as section-{id}.
 # - container__width: narrow, content, wide, or full.
 # - container__alignment: left, center, or right.
 # - container__theme: Theme name, inherited when omitted.
 # - container__theme__variation: light or dark.
 # - container__bg_color: Paint the active theme background.
 # - container__spacing: none, quarter, half, one to four, and edge variants.
 # - container__layout: stacked or inline.
 # - container__style: none or contained.
 # - container__align_intro: Alignment of text within the introduction.
 # - container__overline: Short text above the heading.
 # - container__heading: Heading content.
 # - container__heading_level: Heading level from 2 to 6.
 # - container__subheading: Supporting text below the heading.
 # - container__text: Introduction body text or rendered rich text.
 # - container__link__url: Destination for the introduction link.
 # - container__link__content: Label for the introduction link.
 # - container__intro__after: Place the introduction after the content.
 # - container__blockname: Optional parent block name for the wrapper class.
 # - container__modifiers / container__additional_classes / container__attributes:
 #   Wrapper class and attribute overrides.
 # - container__inner_modifiers / container__inner__additional_classes /
 #   container__inner__attributes: Inner wrapper class and attribute overrides.
 # - container__heading__modifiers / container__heading__additional_classes:
 #   Heading class overrides.
 #
 # Blocks:
 # - container__prefix: Content above the inner wrapper.
 # - container__content: Main content inside the inner wrapper.
 # - container__suffix: Content below the inner wrapper.
 # - container__intro__link: Override the introduction link.
 #}

{% set wrapper_elements = ['div', 'section', 'article', 'aside', 'header', 'footer', 'main', 'nav'] %}
{% set container__element = container__element in wrapper_elements ? container__element : 'div' %}
{% set container__heading_level = container__heading_level in ['2', '3', '4', '5', '6', 2, 3, 4, 5, 6] ? container__heading_level : 2 %}

{# Legacy field values can still be present in installed themes. #}
{% set legacy_widths = {
  'compressed': 'narrow',
  'compact': 'narrow',
  'standard': 'content',
  'extended': 'wide',
  'max': 'wide',
  'page': 'full',
} %}
{% set container__width = container__width|default('content') %}
{% set container__width = legacy_widths[container__width]|default(container__width) %}
{% set container__width = container__width in ['narrow', 'content', 'wide', 'full'] ? container__width : 'content' %}

{% set theme_tokens = container__theme|default('')|trim|split(' ') %}
{% set theme_name = theme_tokens|first %}
{% set theme_variation = theme_tokens|last %}
{% if theme_name in ['standard', 'inverse'] %}
  {% set theme_variation = theme_name == 'inverse' ? 'dark' : 'light' %}
  {% set theme_name = 'default' %}
{% endif %}
{% set theme_variation = container__theme__variation|default(theme_variation) %}

{% set container__modifiers = container__modifiers|default([]) %}
{% set container__attributes = container__attributes|default({}) %}
{% if container__bg_color is same as(true) or container__bg_color is same as('true') %}
  {% set container__modifiers = container__modifiers|merge(['with-bg']) %}
  {% set container__attributes = container__attributes|merge({'data-component-bg': 'true'}) %}
{% endif %}
{% if theme_name or container__theme__variation %}
  {% set theme_variation = theme_variation == 'dark' ? 'dark' : 'light' %}
  {% set container__attributes = container__attributes|merge({
    'data-component-theme': theme_name|default('default') ~ ' ' ~ theme_variation,
  }) %}
{% endif %}
{% if container__id is defined and container__id is not empty %}
  {% set container__attributes = container__attributes|merge({'id': 'section-' ~ container__id}) %}
{% endif %}

{% set container__additional_classes = container__additional_classes|default([]) %}
{% if container__blockname %}
  {% set container__additional_classes = container__additional_classes|merge(['container']) %}
{% endif %}

{% set container__attributes = container__attributes|merge({
  'class': bem('container', container__modifiers, container__blockname, container__additional_classes),
  'data-component-width': container__width,
  'data-component-alignment': container__alignment|default('center'),
  'data-align-container-intro': container__align_intro|default('left'),
  'data-component-layout': container__layout|default('stacked'),
  'data-component-style': container__style|default('none'),
  'data-component-spacing': container__spacing|default('one'),
}) %}

{% set container__inner__attributes = container__inner__attributes|default({})|merge({
  'class': bem('inner', container__inner_modifiers, 'container', container__inner__additional_classes),
}) %}

{% set intro_link %}
  {% block container__intro__link %}
    {% if container__link__url and container__link__content %}
      <a {{ add_attributes({'class': bem('link', [], 'container'), 'href': container__link__url}) }}>{{ container__link__content }}</a>
    {% endif %}
  {% endblock %}
{% endset %}

{% set intro %}
  {% if container__overline or container__heading or container__subheading or container__text or intro_link|trim is not empty %}
    <div {{ bem('intro', [], 'container') }}>
      {% if container__overline %}
        <div {{ bem('overline', [], 'container') }}>{{ container__overline }}</div>
      {% endif %}
      {% if container__heading %}
        <h{{ container__heading_level }} {{ bem('heading', container__heading__modifiers, 'container', container__heading__additional_classes) }}>{{ container__heading }}</h{{ container__heading_level }}>
      {% endif %}
      {% if container__subheading %}
        <div {{ bem('subheading', [], 'container') }}>{{ container__subheading }}</div>
      {% endif %}
      {% if container__text %}
        <div {{ bem('text', [], 'container') }}>{{ container__text|raw }}</div>
      {% endif %}
      {{ intro_link }}
    </div>
  {% endif %}
{% endset %}

<{{ container__element }} {{ add_attributes(container__attributes) }}>
  {% block container__prefix %}{% endblock %}
  <div {{ add_attributes(container__inner__attributes) }}>
    {% if not container__intro__after %}
      {{ intro }}
    {% endif %}

    {% block container__content %}
      {{ include('@layout/placeholder/placeholder.twig', { placeholder__text: 'Placeholder content'|t }, with_context: false) }}
    {% endblock %}

    {% if container__intro__after %}
      {{ intro }}
    {% endif %}
  </div>
  {% block container__suffix %}{% endblock %}
</{{ container__element }}>
