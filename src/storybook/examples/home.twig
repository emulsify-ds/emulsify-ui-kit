<div class="example">
	{% include "@examples/examples/assets/_header.twig" %}
	<main>
		<section class="hero">
			<h1>Future of Education</h1>
			<h2>Innovative Approaches for Tomorrow&rsquo;s Learners</h2>
		</section>
		<section class="watch">
			<h2 class="watch-h2">The Ones to Watch</h2>
			<p>In an environment where innovation and inspiration are in no short supply, meet the trailblazers.</p>
			<div class="watch-grid">
				{% for teaser in teasers %}
					{{ include('@components/teaser/teaser.twig', teaser|merge({ teaser__style: 'card', teaser__heading_level: 3 }), with_context: false) }}
				{% endfor %}
			</div>
		</section>
		<section class="celebrating">
			<h2 class="celebrating-h2">Celebrating Academic Excellence: Top Stories from Our University</h2>
			<div class="celebrating-grid">
				{% for teaser in celebratingTeasers %}
					{{ include('@components/teaser/teaser.twig', teaser|merge({ teaser__style: 'card', teaser__heading_level: 3 }), with_context: false) }}
				{% endfor %}
			</div>
		</section>
	</main>
	{% include "@examples/examples/assets/_footer.twig" %}
</div>
